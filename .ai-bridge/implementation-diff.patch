+        y_after = after(
+            x,
+            attention_mask=None,
+            position_embeddings=rope(x, pos),
+            step_cache=StudentStepCache.new(),
+            use_ste=True,
+        ).output
+    torch.testing.assert_close(y_after.float(), y_before.float(), rtol=2e-2, atol=2e-2)
